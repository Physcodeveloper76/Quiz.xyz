# Backend Server Environment Variables (Private - Never commit .env to Git)
PORT=5000
SECRET_KEY=generate-a-strong-random-key-here-32-chars
ADMIN_USERNAME=organizer
ADMIN_PASSWORD=change-this-secure-password

# Allowed frontend origin (Vercel domain or * for all)
FRONTEND_ORIGIN=https://your-quiz.vercel.app

# MongoDB Atlas connection string (optional - embedded local memory database used if left blank)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quiz_platform?retryWrites=true&w=majority
# MONGODB_DB=quiz_platform
